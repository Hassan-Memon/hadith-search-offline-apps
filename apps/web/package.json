{
  "name": "@tehqeqat/web",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Offline app for tehqeqatehadees.com: an installable web app (PWA) with the whole collection in on-device SQLite.",
  "scripts": {
